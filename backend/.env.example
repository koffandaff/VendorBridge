# Backend environment variables (server-side only, private).
#
# Copy this file to backend/.env and fill in real values:
#   cp backend/.env.example backend/.env
#
# These variables are PRIVATE: never prefix them with NEXT_PUBLIC_ and
# never reference them from the frontend codebase.

# Port the Express server listens on (dev default: 4000)
PORT=4000

# Environment: development | test | production
NODE_ENV=development

# ---------------------------------------------------------------------------
# Supabase PostgreSQL
#
# From Supabase -> Connect -> ORMs -> Prisma:
#
#   DATABASE_URL - transaction-mode pooler (port 6543, ?pgbouncer=true).
#                  Used by the Prisma Client at runtime.
#   DIRECT_URL   - session-mode pooler (port 5432). Used by Prisma Migrate
#                  (supports DDL, which the transaction pooler does not).
#
# Replace [YOUR-PASSWORD] below. If the password contains special characters
# (e.g. '@'), percent-encode them in the URL (e.g. @ -> %40).
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://postgres.<PROJECT-REF>:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true
DIRECT_URL=postgresql://postgres.<PROJECT-REF>:[YOUR-PASSWORD]@aws-0-ap-northeast-1.pooler.supabase.com:5432/postgres

# ---------------------------------------------------------------------------
# Authentication
# ---------------------------------------------------------------------------

# Secret used to sign JWT access tokens (HS256). Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_ACCESS_SECRET=[GENERATE-A-RANDOM-SECRET-AT-LEAST-32-CHARACTERS]

# Access token lifetime, in jsonwebtoken notation (e.g. 15m, 1h, 7d, 86400)
JWT_ACCESS_EXPIRES_IN=15m

# Refresh (session) token lifetime in days
REFRESH_TOKEN_EXPIRES_DAYS=30

# OTP verification code lifetime in minutes
OTP_EXPIRES_MINUTES=10

# ---------------------------------------------------------------------------
# Frontend / CORS
# ---------------------------------------------------------------------------
CLIENT_URL=http://localhost:3000

# Comma-separated list of allowed browser origins (never use * for
# authenticated applications)
CORS_ORIGINS=http://localhost:3000

# ---------------------------------------------------------------------------
# SMTP (email delivery)
# ---------------------------------------------------------------------------
# If unset, the backend falls back to printing emails to the console, which
# is convenient for development. SMTP is REQUIRED in production.
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USER=no-reply@example.com
# SMTP_PASS=your-smtp-password
# SMTP_FROM=VendorBridge <no-reply@example.com>