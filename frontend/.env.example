# Frontend environment variables.
#
# Copy this file to frontend/.env.local for `next dev`:
#   cp frontend/.env.example frontend/.env.local
#
# Public variables (NEXT_PUBLIC_*) are inlined into the browser bundle -
# anyone can read them. NEVER put secrets, API keys, or credentials here.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Server-only variables (without the NEXT_PUBLIC_ prefix) are never exposed
# to the browser, but the backend owns all private configuration anyway:
# database access and secrets live in backend/.env (see backend/.env.example).